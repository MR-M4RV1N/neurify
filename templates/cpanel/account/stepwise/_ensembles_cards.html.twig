<div class="main-content-container container-fluid mb-5">
    <div class="row">

        {% for item in ensembles %}
            {% if '/cpanel/collections/ai' in app.request.uri %}
                {% set url = path('collections_open_ensemble', {'id': item.id}) %}
            {% elseif '/cpanel/collections/platform' in app.request.uri %}
                {% set url = path('users_stepwised_ensemble_open', {'ensemble': item.id}) %}
            {% elseif '/cpanel/collections/my' in app.request.uri %}
                {% set url = path('stepwised_ensemble_open', {'ensemble': item.id}) %}
            {% elseif '/cpanel/users/collections' in app.request.uri %}
                {% set url = path('users_stepwised_ensemble_open', {'ensemble': item.id}) %}
            {% endif %}

            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                <div class="card card-small card-post card-post--1 h-100">

                    {% if item.image is not empty %}
                        <div class="card-post__image"
                             style="background-image: url('{{ asset('cpanel/ensemble/uploads/images/' ~ item.image) }}');">
                    {% else %}
                            {% if '/cpanel/users/collections' in app.request.uri %}
                            <div class="card-post__image"
                                 style="background-image: url('{{ asset('cpanel/ensemble/uploads/images/default-2.jpg') }}');">
                            {% else %}
                            <div class="card-post__image"
                                 style="background-image: url('{{ asset('cpanel/ensemble/uploads/images/default.jpg') }}');">
                            {% endif %}
                    {% endif %}
                        <div class="card-post__author d-flex">
                            {% if '/cpanel/collections/ai' in app.request.uri %}
                                {% set image = '/images/nf-ai.png' %}
                                {% set url = path('collections_open_ensemble', {'id': item.id}) %}
                            {% else %}
                                {% if item.author.image is not empty %}
                                    {% set image = '/cpanel/profile/uploads/images/' ~ item.author.image %}
                                {% else %}
                                    {% set image = asset('/cpanel/images/avatars/default.png') %}
                                {% endif %}
                            {% endif %}
                            <a href="#" class="card-post__author-avatar card-post__author-avatar--small"
                               style="background-image: url('{{ image }}');">Written by Anna Kunis</a>
                        </div>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <span class="text-fiord-blue">{{ item.title }}</span>
                        </h5>

                        <p class="card-text text-muted small flex-grow-1">
                            {{ item.description|length > 200
                            ? item.description|slice(0, 200) ~ '...'
                            : item.description }}
                        </p>

                        <div class="d-flex justify-content-between align-items-center">
                            {% if item.createdAt is defined %}
                                <span class="text-muted small mt-1">
                        {{ item.createdAt|date('d.m.Y') }}
                    </span>
                            {% endif %}

                            <a href="{{ url }}" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-folder-open"></i>
                                {% trans %}Open{% endtrans %}
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="col">
                <div class="alert alert-light text-center">
                    {% trans %}There are no categories{% endtrans %}
                </div>
            </div>
        {% endfor %}

    </div>

    {% if '/cpanel/collections/ai' in app.request.uri%}
        <div class="d-flex justify-content-center mb-5">
            <a href="{{ path('ai_task_new') }}" class="btn btn-sm btn-primary" id="add-category-button">
                <i class="material-icons">add</i> {% trans %}Generate{% endtrans %}
            </a>
        </div>
    {% endif %}
    {% if '/cpanel/collections/my' in app.request.uri%}
        <div class="d-flex justify-content-center mb-5">
            <a href="{{ path('app_ensemble_new') }}" class="btn btn-sm btn-primary" id="add-category-button">
                <i class="material-icons">add</i> {% trans %}Add category{% endtrans %}
            </a>
        </div>
    {% endif %}
</div>