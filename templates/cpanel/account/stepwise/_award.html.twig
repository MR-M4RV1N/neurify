<div class="mb-5">
	{% set completed = completedQuests|length %}
	{% set remaining = todoQuests|length %}
	{% set total = completed + remaining %}
	{% set progress = total > 0 ? (completed / total * 100) : 0 %}

	{% set r = 50 %}
	{% set C = 2 * 3.1415926535 * r %}
	{% set offset = C * (1 - (progress / 100)) %}

	{% set ringColor = '#28a745' %}
	<style>
		.progress-badge {
			position: relative;
			width: 140px;
			height: 140px;
			margin: 0 auto;
		}
		.progress-ring {
			transform: rotate(-90deg);
		}

		/* Белый фон круга */
		.ring-bg {
			fill: #fff;
			stroke: #e9ecef;
			stroke-width: 10;
			filter: drop-shadow(-10px 0px 5px rgba(0,0,0,0.20)); /* тень снизу */
		}

		/* Тонкая обводка по краю */
		.ring-border {
			fill: none;
			stroke: #000;
			stroke-width: 1;
			opacity: 0.2;
		}

		/* Цветное кольцо прогресса */
		.ring-fg {
			fill: none;
			stroke-width: 10;
			stroke-linecap: round;
			transition: stroke-dashoffset 0.6s ease;
		}

		/* Кубок */
		.badge-icon {
			position: absolute;
			top: 50%;
			left: 50%;
			transform: translate(-50%, -50%);
			width: 50px;
			height: 50px;
			object-fit: contain;
		}
	</style>

	<div class="progress-badge text-center">
		<svg
			width="140" height="140" viewbox="0 0 140 140" class="progress-ring">
			<!-- Фоновое кольцо (белый круг с серым контуром) -->
			<circle
			cx="70" cy="70" r="{{ r }}" class="ring-bg"/>
			<!-- Активное кольцо прогресса -->
			<circle cx="70" cy="70" r="{{ r }}" class="ring-fg" style="
			                            stroke-dasharray: {{ C }}, {{ C }};
			                            stroke-dashoffset: {{ offset }};
			                            stroke: {{ ringColor }};
			                            "/>
		</svg>

		<img src="/images/{{ remaining == 0 and total > 0 ? 'award.png' : 'award_grey.png' }}" alt="Достижения" class="badge-icon" width="50" height="50"/>
	</div><br><br>
</div>
