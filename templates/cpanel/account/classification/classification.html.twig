{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Ensemble index
{% endblock %}

{% block body %}
	{% include '/cpanel/account/_profile.html.twig' %}
	<div class="text-center mt-3 mx-1">
		{{ app.user.description }}
	</div>
	{% include '/cpanel/account/_tabs.html.twig' %}

	<div class="container text-center mb-3">
		<form method="get" action="{{ path('app_account_classification') }}" class="d-inline-block">
			<select name="year" class="form-control form-control-sm d-inline-block w-auto" onchange="this.form.submit()">
				{% for y in range(currentYear, currentYear - 6) %}
					<option value="{{ y }}" {{ y == selectedYear|default(currentYear) ? 'selected' : '' }}>
						{{ y }}
					</option>
				{% endfor %}
			</select>
		</form>
	</div>

	<div class="main-content-container container-fluid px-4">
		<div class="row mt-4">
			<div class="col-12">
				{% include '/cpanel/account/classification/_classification.html.twig' %}
			</div>
		</div>
	</div>
	<!-- Spacer -->
	<div class="my-5"></div>

	<!-- /init/menu-toggle (не используется) -->
	<!-- /init/intro-init.js -->
{% endblock %}
