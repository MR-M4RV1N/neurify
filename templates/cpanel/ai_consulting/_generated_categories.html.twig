<div class="main-content-container container-fluid mb-5">
    <!-- Page Header -->
    <div class="page-header row no-gutters mb-3">
        <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <span class="text-uppercase page-subtitle">
                    {% trans %}Generated categories{% endtrans %}
                </span>
        </div>
    </div>
    <div class="bg-white border-top border-bottom shadow mb-5">
        <div class="card-body border-bottom">
            <!-- Таблица -->
            <table class="table table-light">
                <tbody>
                {% for g in generatedCategories %}
                    <tr class="text-center">
                        <td>
                            <a class="text-fiord-blue" href="{{ path('app_ensemble_open', { id: g.id }) }}">
                                {{ g.title }}: {{ g.createdAt|date('d.m.Y') }}
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr class="text-center">
                        <td>
                            Пока что нет событий с AI-комментариями.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>