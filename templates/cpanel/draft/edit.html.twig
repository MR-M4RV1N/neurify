{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Edit Draft{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- HEADER... -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <h3 class="page-title">{% trans %}Edit record{% endtrans %}</h3>
            </div>
        </div>
        <!-- ...HEADER -->
        <div class="row">
            <div class="col">
                <div class="card card-small">
                    <div class="card-header border-bottom">
                        <a href="{{ path('app_draft_index') }}" class="btn btn-sm btn-outline-secondary"><i class="material-icons">arrow_back</i> {% trans %}Back{% endtrans %}</a>
                    </div>
                    <div class="card-body">
                        {{ include('cpanel/draft/_form.html.twig', {'button_label': 'Update'|trans}) }}
                    </div>
                    <div class="card-footer border-top">
                        <div class="text-right">
                            {{ include('cpanel/draft/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
