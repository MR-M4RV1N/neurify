<form class="ml-2" method="post" action="{{ path('app_picture_delete', {'id': picture.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ picture.id) }}">
    <div>
        <button class="btn btn-sm btn-outline-danger"><i class="material-icons">delete</i> {% trans %}Delete{% endtrans %}</button>
    </div>
</form>
