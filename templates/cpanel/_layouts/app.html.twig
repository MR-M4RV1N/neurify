<!doctype html>
<html class="no-js h-100" lang="lv">
	<head>
		<meta charset="utf-8">
		<meta http-equiv="x-ua-compatible" content="ie=edge">
		<link rel="manifest" href="{{ asset('manifest.json') }}">
		<title>
			{% block title %}Cpanel
			{% endblock %}
		</title>
		<meta name="description" content="A high-quality &amp; free Bootstrap cpanel dashboard template pack that comes with lots of templates and components.">
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
		<meta name="google" content="notranslate">
		<link href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet">
		<link
		href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
		<!-- Подключение Bootstrap CSS -->
		<link rel="stylesheet" href="{{ asset('bootstrap-4.5.3-dist/css/bootstrap.min.css') }}">
		<link rel="stylesheet" id="main-stylesheet" data-version="1.1.0" href="/cpanel/styles/accents/warning.1.1.0.min.css">
		<link rel="stylesheet" href="/cpanel/styles/extras.1.1.0.min.css">
		<link rel="stylesheet" href="/styles/css/styles.css">
		<script src="https://buttons.github.io/buttons.js"></script>
		<script src="/js/ckeditor-min/ckeditor.js"></script>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intro.js/5.0.0/introjs.min.css"/>
		<script src="https://cdnjs.cloudflare.com/ajax/libs/intro.js/5.0.0/intro.min.js"></script>
		<link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css"/>
		<script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.css"/>
		<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
		{{ encore_entry_link_tags('app') }}
		{{ encore_entry_link_tags('fancybox') }}
		{% block scripts %}{% endblock %}
		{% block styles %}{% endblock %}
		{{ encore_entry_script_tags('app') }}
	</head>
	<body class="h-100">
		<div class="container-fluid">
			<div
				class="row">
				<!-- Sidebar -->
				{% include '/cpanel/_layouts/_sidebar.html.twig' %}

				<main
					class="main-content col-lg-10 col-md-9 col-sm-12 p-0 offset-lg-2 offset-md-3 mb-5">
					<!-- Topbar -->
					{% include '/cpanel/_layouts/_topbar.html.twig' %}

					<!-- Content -->
					<div id="content-frame" data-turbo-frame="content-frame"> {% block body %}{% endblock %}
						</div>

						<!-- Bottom menu -->
						{% if app.request.attributes.get('_route') != 'app_cpanel_presentation' %}
							{% include '/cpanel/_layouts/_bottom_menu.html.twig' %}
						{% endif %}
					</main>
				</div>
			</div>

			{{ encore_entry_script_tags('fancybox') }}
			<script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/dropzone.min.js"></script>
			<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.1/umd/popper.min.js"></script>
			<!-- Подключение Bootstrap JS -->
			<script src="{{ asset('bootstrap-4.5.3-dist/js/bootstrap.min.js') }}"></script>
			<script src="https://unpkg.com/shards-ui@latest/dist/js/shards.min.js"></script>
			<script src="https://cdnjs.cloudflare.com/ajax/libs/Sharrre/2.0.1/jquery.sharrre.min.js"></script>
			<script src="/cpanel/scripts/extras.1.1.0.min.js"></script>
			<script src="/cpanel/scripts/shards-dashboards.1.1.0.min.js"></script>
			<script src="/cpanel/scripts/app/app-blog-overview.1.1.0.js"></script>
			<!-- Подключение скрипта для линии загрузки -->
			<script src="/cpanel/scripts/loading/loading.js"></script>
		</body>
	</html>
