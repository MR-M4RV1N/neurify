<div class="add-menu-wrapper d-none" id="addMenu">
    <div class="add-menu-lux">
        <a href="{{ path('journal_edit', {date: "now"|date('Y-m-d')}) }}">
            <img src="{{ asset('/icons/notepad_9625716.png') }}" alt="Icon" width="24" style="margin-bottom: 5px; filter: brightness(0) invert(1); margin-right: 7px; margin-top:7px;">
            <span>{% trans %}Record{% endtrans %}</span>
        </a>
        <div class="border-bottom"></div>

        <a href="{{ path('cpanel_small_step_new', { type: 'idea' }) }}">
            <img src="{{ asset('/icons/light-bulb_2667427.png') }}" alt="Icon" width="24"
                 style="margin-bottom: 5px; filter: brightness(0) invert(1); margin-right: 7px; margin-top:7px;">
            <span>{% trans %}Idea{% endtrans %}</span>
        </a>
        <div class="border-bottom"></div>

        <a href="{{ path('cpanel_small_step_new', { type: 'step' }) }}">
            <img src="{{ asset('/icons/footprints_6027133.png') }}" alt="Icon" width="24"
                 style="margin-bottom: 5px; filter: brightness(0) invert(1); margin-right: 7px; margin-top:7px;">
            <span>{% trans %}Small step{% endtrans %}</span>
        </a>
        <div class="border-bottom"></div>

        <a href="/cpanel/editor/events/new?type=1">
            <img src="{{ asset('/icons/star_7588772_t5px.png') }}" alt="Icon" width="24" style="margin-bottom: 5px; filter: brightness(0) invert(1); margin-right: 7px;">
            <span>{% trans %}Memorable event{% endtrans %}</span>
        </a>
    </div>
    <div class="menu-arrow-lux"></div>
</div>

