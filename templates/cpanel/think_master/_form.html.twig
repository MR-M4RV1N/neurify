{{ form_start(form, {
    'action': path('note_create'),
    'method': 'POST'
}) }}

<div class="form-group">
    {{ form_label(form.text) }}
    {{ form_widget(form.text, {'attr': {
        'class': 'form-control',
        'data-ckeditor': 'true'
    }}) }}
</div>

<div class="form-group">
    {{ form_label(form.next) }}
    {{ form_widget(form.next, { 'attr': {'class': 'form-control'} }) }}
</div>

<div class="form-group">
    {{ form_label(form.recommendations) }}
    {{ form_widget(form.recommendations, { 'attr': {'class': 'form-control'} }) }}
</div>

<button class="btn btn-primary">{{ button_label }}</button>

{{ form_end(form) }}