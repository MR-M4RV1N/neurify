{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}{% trans %}New achievement{% endtrans %}{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- HEADER... -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <h3 class="page-title mb-2">{% trans %}Resource map{% endtrans %}</h3>
                <span class="text-uppercase page-subtitle">

                </span>
            </div>
        </div>
        <!-- ...HEADER -->
        <!-- CONTENT... -->
        <div class="row border bg-white p-2">
            <a href="{{ path('ai_consulting')}}" class="btn btn-sm btn-outline-secondary"><i class="fas fa-angle-left"></i> {% trans %}back{% endtrans %}</a>
        </div>
        <div class="row border bg-white mb-5">
            <div class="col-lg-12 col-md-12 col-sm-12 mt-4 mb-4">
                {% if resourceMap and resourceMap.updatedAt %}
                    <p class="text-muted text-right">
                        {% trans %}Обновлено{% endtrans %}: {{ resourceMap.updatedAt|date('Y-m-d H:i') }}
                    </p>
                {% endif %}

                <div class="mb-5">
                    {% if app.user.lang == 'en' %}
                        {{ include('/cpanel/resource_map/_en.html.twig') }}
                    {% elseif app.user.lang == 'lv' %}
                        {{ include('/cpanel/resource_map/_lv.html.twig') }}
                    {% else %}
                        {{ include('/cpanel/resource_map/_ru.html.twig') }}
                    {% endif %}
                </div>


                {{ form_start(form) }}
                <div class="form-group">
                    <div class="d-flex align-items-center">
                        {{ form_label(form.content, 'Resource map', {'label_attr': {'class': 'form-label mb-0'}}) }}

                        <button type="button"
                                class="btn btn-link"
                                data-toggle="modal"
                                data-target="#resourceMapExampleModal">
                            {% trans %}Example{% endtrans %}
                        </button>
                    </div>

                    {{ form_widget(form.content, {'attr': {
                        'class': 'form-control',
                        'rows': 10,
                        'data-ckeditor': 'true',
                        'placeholder': 'Describe your resource map…'
                    }}) }}

                    {{ form_errors(form.content) }}
                </div>

                <div class="text-center mt-2">
                    {{ form_row(form.save) }}
                </div>
                {{ form_end(form) }}
            </div>
        </div>
        <!-- ...CONTENT -->
    </div>

    {# --- Bootstrap 4 modal с примером --- #}
    <div class="modal fade" id="resourceMapExampleModal" tabindex="-1" role="dialog" aria-labelledby="resourceMapExampleLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 id="resourceMapExampleLabel" class="modal-title">Resource map — example format</h6>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>

                <div class="modal-body">
                    <p class="mb-2">Use one line per item:</p>
                    <p class="mb-3"><code>1. [Title]. [Short description]. [Why it can help].</code></p>

                    <div class="bg-light p-3 rounded">
<pre class="mb-0" style="white-space: pre-wrap;">
1. City Career Center. Free workshops on resumes, interview prep, and job search. Helps with mentorship and networking aligned with my goals.
2. University Extension Program. Evening certificates in data analysis and project management. Offers practical courses, alumni network, and career services.
3. Tech Meetup Group. Monthly events for developers and founders. Provides peer support, lightning talks, and potential collaborators.
4. Mental Health Hotline. 24/7 confidential counseling and referrals. Supports resilience and reduces burnout risk during tough periods.
5. Public Library. Access to databases, study rooms, and skill-building events. Enables free learning resources and a quiet workspace nearby.
</pre>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}