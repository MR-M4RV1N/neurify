{% if isGenerated == true %}
    {% trans %}Generation successfully completed{% endtrans %}.
    <a href="{{ path('app_share_show', {id: event.id}) }}">
        {% trans %}Open{% endtrans %}
    </a>
{% else %}
    <div class="text-center">
        {# Кнопка "Создать пост" #}
        <button type="button"
                class="mb-2 btn btn-pill btn-primary mr-2"
                data-toggle="modal"
                data-target="#shareGenerateModal">
            {% trans %}Create post{% endtrans %}
            <i class="fa fa-magic ml-2" aria-hidden="true"></i>
        </button>
    </div>

    {# Modal: рекомендации для ИИ перед генерацией #}
    <div class="modal fade" id="shareGenerateModal" tabindex="-1" role="dialog"
         aria-labelledby="shareGenerateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">

                <form method="post" action="{{ path('app_share_generate', { id: event.id }) }}">
                    <div class="modal-header">
                        <h5 class="modal-title" id="shareGenerateModalLabel">
                            {% trans %}Extra instructions{% endtrans %}
                        </h5>
                        <button type="button" class="close" data-dismiss="modal"
                                aria-label="{% trans %}Close{% endtrans %}">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" name="_token" value="{{ csrf_token('app_share_generate') }}">

                        <div class="form-group">
                            <label for="ai_hint">
                                {% trans %}Enter your instructions{% endtrans %}
                            </label>
                            <textarea id="ai_hint"
                                      name="ai_hint"
                                      class="form-control"
                                      rows="4"
                                      placeholder=""></textarea>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">
                            {% trans %}Cancel{% endtrans %}
                        </button>
                        <button type="submit" class="btn btn-primary">
                            {% trans %}Generate post{% endtrans %}
                            <i class="fa fa-magic ml-2" aria-hidden="true"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endif %}