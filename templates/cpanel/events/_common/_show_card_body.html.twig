<div class="card-body">
    {% include '/cpanel/events/_common/_images.html.twig' %}

    <div class="col col-md-6 mx-auto mt-3">
        <h6 class="m-0 text-center">{{ event.title }}</h6>
        <p class="text-center">{% trans %}completed at{% endtrans %}: {{ event.date|date('Y-m-d') }}</p>
    </div>

    <div class="col col-md-6 mx-auto mt-3">
        <p class="text-justify devstyle-text-indent">{{ event.description|raw }}</p>
    </div>
    <div class="col col-md-6 mx-auto mt-3">
        <!-- Если event.instruction не пустое, тогда отобразить -->
        {% if event.instruction %}
            <h6 class="text-center">{% trans %}Instruction{% endtrans %}</h6>
        {% endif %}
        <p class="text-justify devstyle-text-indent m-0 p-0">{{ event.instruction|raw }}</p>

        {% if event.instructionFile %}
            <div class="mb-5">
                {% set file = event.instructionFile %}
                {% set ext = file|split('.')|last|lower %}

                {% if ext == 'pdf' %}
                    {% set icon = 'picture_as_pdf' %}
                {% elseif ext in ['ppt', 'pptx'] %}
                    {% set icon = 'slideshow' %}
                {% else %}
                    {% set icon = 'insert_drive_file' %}
                {% endif %}

                <a href="{{ asset('uploads/instructions/' ~ file) }}" target="_blank">
                    <i class="material-icons">{{ icon }}</i> {% trans %}Download the instruction file{% endtrans %}
                </a>
            </div>
        {% endif %}

        {% if event.user.id == app.user.id
            and event.ensemble is not null
            and event.ensemble.aiGenerated
            and not event.aiCompleted %}
            <div class="mt-3">
                {% if event.user.id == app.user.id
                    and event.ensemble is not null
                    and event.ensemble.aiGenerated
                    and not event.aiCompleted %}
                    <div class="text-center">
                        {% include '/cpanel/events/_common/_mark_as_completed.html.twig' %}
                    </div>
                {% endif %}

                {% if event.user.id == app.user.id and event.aiGenerated == true and event.aiCompleted == true %}
                    {% include '/cpanel/events/_common/_share_generate.html.twig' %}
                {% endif %}

                {% if event.user.id == app.user.id and event.aiGenerated == false %}
                    {% include '/cpanel/events/_common/_share_generate.html.twig' %}
                {% endif %}
            </div>
        {% else %}
            {% if event.user.id != app.user.id %}
                {% include '/cpanel/events/_common/_mark_as_completed.html.twig' %}
            {% endif %}
        {% endif %}
    </div>

    {% include 'cpanel/dashboard/_common/_modal.html.twig' %}
    {% include 'cpanel/dashboard/_common/_script.html.twig' %}
</div>