<!-- Используется /components/_account-list.scss -->
<div class="mb-2 mx-auto text-center mt-3">
    {% include '/cpanel/events/user/_avatar.html.twig' %}

    <div class="pt-4">
        <div class="text-center pb-1">
            {% set path = app.request.pathinfo %}
            {% if '/cpanel/ai-task/open' in path %}
                <div>
                    {% include '/cpanel/chat/_tabs.html.twig' %}
                </div>
            {% else %}
                <!--<p>{{ profile.description }}</p>-->
                https://neurify.life/u/{{ profile.username }}
                <div class="d-flex justify-content-center">
                    <div data-share-button data-url="https://neurify.life/u/{{ profile.username }}"
                         class="position-relative text-center" style="line-height: 0;">
                        <button class="btn btn-link m-0 p-0" style="font-weight: 400;">
                            <i class="fas fa-copy mr-1"></i>
                            <span class="text-uppercase page-subtitle">{% trans %}Copy{% endtrans %}</span>
                        </button>
                        <span data-share-message class="position-absolute w-100 text-success"
                              style="top: 7px; font-size: 12px; display: none;">Скопировано!</span>
                    </div>
                </div>
            {% endif %}
        </div>
        <h4 class="mb-0">{{ profile.firstname }} {{ profile.lastname }}</h4>
        <a href="/cpanel/resume/events">
            <span class="text-uppercase page-subtitle" id="user-selected-artisan">{{ profile.artisan }}</span>
        </a>
    </div>


    <div class="text-center mt-2 mb-4 mx-2">
        {{ profile.description }}
    </div>
</div>

