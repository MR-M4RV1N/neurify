{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}В разработке
{% endblock %}

{% block body %}
	{% include '/cpanel/events/user/_profile.html.twig' %}

	{% include '/cpanel/events/user/_tabs.html.twig' %}

	<div class="container text-center mb-3">
		<form method="get" action="{{ path('app_users_statistics', { id: profile.id }) }}" class="d-inline-block">
			<select name="year" class="form-control form-control-sm d-inline-block w-auto" onchange="this.form.submit()">
				{% for y in range(currentYear, currentYear - 6) %}
					<option value="{{ y }}" {{ y == selectedYear ? 'selected' : '' }}>
						{{ y }}
					</option>
				{% endfor %}
			</select>
		</form>
	</div>

	{% include '/cpanel/activity/_body.html.twig' %}
{% endblock %}
