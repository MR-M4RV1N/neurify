<div class="profile-avatar-container">
    <div class="avatar-wrapper">
        <img class="rounded-circle" src="/cpanel/profile/uploads/images/{{ profile.image }}" alt="User Avatar"
             style="width: 100%; height: 100%; object-fit: cover;">
        <a href="/cpanel/progress/{{ profile.id }}">
            <img src="/images/L{{ level }}.png" alt="About Neurify" class="mini-icon-level" id="user-level">
        </a>
    </div>
</div>