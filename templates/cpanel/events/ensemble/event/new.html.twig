{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}New Event{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- HEADER... -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <h3 class="page-title">{% trans %}Create new record{% endtrans %}</h3>
            </div>
        </div>
        <!-- ...HEADER -->
        <div class="row">
            <div class="col">
                <div class="card card-small">
                    <div class="card-body">
                        {{ include('/cpanel/events/ensemble/event/_form.html.twig') }}
                    </div>
                    <div class="card-footer border-top">
                        <a href="{{ path('app_events_list')}}" class="btn btn-sm btn-outline-secondary"><i class="material-icons">arrow_back</i> {% trans %}back{% endtrans %}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
