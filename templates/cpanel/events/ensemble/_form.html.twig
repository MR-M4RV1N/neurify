{{ form_start(form) }}

<div class="form-group">
    {{ form_label(form.title) }}
    {{ form_widget(form.title) }}
    {{ form_errors(form.title) }}
</div>

<div class="form-group">
    {{ form_label(form.description) }}
    {{ form_widget(form.description) }}
    {{ form_errors(form.description) }}
</div>

{% if ensemble.aiGenerated or ensemble.selected %}
    <div class="form-group">
        {{ form_label(form.image) }}
        {{ form_widget(form.image) }}
        {{ form_errors(form.image) }}
    </div>
{% else %}
    {% do form.image.setRendered %}
{% endif %}

<div class="form-group">
    {{ form_label(form.is_closed) }}
    {{ form_widget(form.is_closed) }}
    {{ form_errors(form.is_closed) }}
</div>

{% if ensemble.aiGenerated == 0 %}
    <div class="form-group">
        {{ form_label(form.selected) }}
        {{ form_widget(form.selected) }}
        {{ form_errors(form.selected) }}
    </div>
{% else %}
    {% do form.selected.setRendered %}
{% endif %}

<div class="text-center">
    <button class="btn btn-sm btn-outline-primary mt-5">
        <i class="material-icons">save</i> {{ button_label|default('Save'|trans) }}
    </button>
</div>

{{ form_end(form) }}

<!-- Bootstrap Modal -->
<div class="modal fade" id="confirmFavoriteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Favorite</h5>
            </div>
            <div class="modal-body">
                Are you sure you want to mark this folder as favorite?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Confirm</button>
            </div>
        </div>
    </div>
</div>

