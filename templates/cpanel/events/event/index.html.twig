{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Event index{% endblock %}

{% block styles %}
    <style>
        #output {
            font-size: 14px;
            font-family: 'Courier New', Courier, monospace;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- Page Header -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <h3 class="page-title mb-2">{% trans %}My achievements{% endtrans %}</h3>
                <span class="text-uppercase page-subtitle">
                    {% trans %}Progress{% endtrans %}: {{ app.user.progress }}/100
                </span>
            </div>
        </div>

        <!--<div class="mb-4 text-center">
            {% set path = app.request.pathinfo %}
            <div class="btn-group btn-group-toggle d-inline-flex">
                <a href="/cpanel/editor/draft" class="btn btn-white btn-sm px-2 {{ path|area('/draft') }}">Планируемые</a>
                <a href="/cpanel/editor/events/list" class="btn btn-white btn-sm px-2 {{ path|area('/events') }}">Выполненные</a>
                <a href="/cpanel/editor/blanks/1" class="btn btn-white btn-sm px-2 {{ path|area('/blanks') }}">Рекомендуемые</a>
            </div>
        </div>-->

        {% include '/cpanel/events/_common/_iteration.html.twig' %}
    </div>

    {% if events|length > 0 %}
        <!-- ADD FLOATING BUTTON -->
        <div class="devstyle-floating-button" onclick="location.href='{{ path('app_event_new') }}'">+</div>
    {% endif %}
{% endblock %}
