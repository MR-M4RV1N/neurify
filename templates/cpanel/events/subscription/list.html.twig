{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Event index{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- Page Header -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <span class="text-uppercase page-subtitle">{% trans %}Subscriptions{% endtrans %}</span>
                <h3 class="page-title mb-2">{% trans %}Try to repeat{% endtrans %}</h3>
            </div>
        </div>

        <div class="mb-4 text-center">
            {% set path = app.request.pathinfo %}
            <div class="btn-group btn-group-toggle d-inline-flex">
                <a href="/cpanel/public/list" class="btn btn-white btn-sm px-2 {{ path|area('/public') }}">Все</a>
                <a href="/cpanel/editor/events/list" class="btn btn-white btn-sm px-2 {{ path|area('/subscription') }}">Подписки</a>
            </div>
        </div>

        {% include '/cpanel/events/_common/_iteration.html.twig' %}
    </div>
{% endblock %}
