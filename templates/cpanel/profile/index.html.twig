{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}User profile{% endblock %}

{% block body %}
        <!-- Если is_verified !== 1 -->
        {% if not app.user.isVerified %}
            <div class="alert alert-accent alert-dismissible fade show mb-0" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
                <i class="fa fa-info mx-2"></i>
                <strong>{% trans %}Please verify your email.{% endtrans %}</strong> {% trans %}Check your email for a verification link.{% endtrans %}
                <form action="{{ path('app_resend_verification_email') }}" method="post">
                    <button type="submit"
                            class="btn btn-sm text-white">{% trans %}Resend verification email{% endtrans %}</button>
                </form>
            </div>
        {% endif %}
        <div class="row">
            <div class="col">
                <!-- Сообщение -->
                {% for label, messages in app.session.flashBag.all %}
                    <div class="alert alert-accent alert-dismissible fade show mt-4" role="alert">
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                        <i class="fa fa-info mx-2"></i>
                        {% for message in messages %}
                            <strong>{{ message|raw }}</strong>
                        {% endfor %}
                    </div>
                {% endfor %}
                <div class="bg-white border-top shadow mb-4 pt-3 mt-4">
                    <div class="card-header border-bottom text-center">
                        <div class="mb-3 mx-auto">
                            <img class="rounded-circle devstyle-user-avatar"
                                 src="/cpanel/profile/uploads/images/{{ app.user.image }}" alt="User Avatar"
                                 width="110">
                        </div>
                        <h4 class="mb-0">{{ app.user.firstname }} {{ app.user.lastname }}</h4>
                    </div>
                    <ul class="list-group list-group-flush">
                        <h6 class="text-center mt-3">{{ app.user.artisan }}</h6>
                        <li class="list-group-item">
                            <strong class="text-muted d-block mb-2">{% trans %}Description{% endtrans %}</strong>
                            <span>
                                {{ app.user.description }}
                            </span>
                        </li>
                    </ul>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item px-4">
                            <div class="progress-wrapper">
                                <strong class="text-muted d-block mb-2">{% trans %}Progress{% endtrans %}</strong>
                                <div class="progress progress-sm">
                                    {% set part = app.user.progress %}
                                    {% set total = 81 %}
                                    <div class="progress-bar bg-primary" role="progressbar"
                                         aria-valuenow="{{ app.user.progress }}" aria-valuemin="0" aria-valuemax="81"
                                         style="width: {{ (part / total * 100)|number_format(0) ~ '%' }};">
                                        <span class="progress-value">{{ (part / total * 100)|number_format(0) ~ '%' }}</span>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="list-group-item p-4 text-center">
                            <form action="{{ path('app_events_list') }}" method="get">
                                <button type="submit" class="mb-2 btn btn-sm btn-pill btn-outline-primary mr-2">
                                    <i class="material-icons mr-1">input</i>{% trans %}Open{% endtrans %}
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

    <div class="main-content-container container-fluid">
        <div class="row">
            <div class="col">
                <div class="card card-small p-1 mt-4 mb-5">
                    <div class="card-header border-bottom">
                        <h6 class="m-0 text-center">{{ app.user.email }}</h6>
                    </div>
                    <div class="card-body p-0 p-3">
                        {{ form_start(form, {'method': 'POST'}) }}
                        <div>
                            {{ form_row(form.username, {
                                attr: {
                                    'data-username-check-url': path('check_username'),
                                    'data-username-check-target': '#username-check',
                                    'data-register-button-id': 'register-button'
                                }
                            }) }}
                            <!-- Вывод ошибок валидации имени пользователя -->
                            {% if form.username.vars.errors %}
                                {% for error in form.username.vars.errors %}
                                    <div class="alert alert-danger">
                                        {{ error.message }}
                                    </div>
                                {% endfor %}
                            {% endif %}
                            <!-- Проверить имя пользователя на доступность -->
                            <div id="username-check" class="alert alert-danger d-none" data-error-msg="{{ 'Username already exists.'|trans }}"></div>                        <div class="text-center m-3">
                        </div>
                        <div class="text-left mb-4">
                            {% trans %}Password{% endtrans %}: <a href="/cpanel/change-password">{% trans %}change{% endtrans %}</a>
                        </div>
                        <div class="text-center m-3">
                            <i class="material-icons">arrow_drop_down</i> <!-- Иконка Font Awesome как разделитель -->
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.type) }}
                            {{ form_widget(form.type) }}
                            {{ form_errors(form.type) }}
                        </div>
                        <div class="text-center m-3">
                            <i class="material-icons">arrow_drop_down</i> <!-- Иконка Font Awesome как разделитель -->
                        </div>
                        <div>
                            {{ form_row(form.firstname) }}
                            {{ form_row(form.lastname) }}
                        </div>
                        <div class="text-center m-3">
                            <i class="material-icons">arrow_drop_down</i> <!-- Иконка Font Awesome как разделитель -->
                        </div>
                        <div>
                            {{ form_row(form.country) }}
                            {{ form_row(form.location) }}
                            {{ form_row(form.lang) }}
                        </div>
                        <div class="text-center m-3">
                            <i class="material-icons">arrow_drop_down</i> <!-- Иконка Font Awesome как разделитель -->
                        </div>
                        <div>
                            {{ form_row(form.image) }}
                        </div>
                        <div class="text-center m-3">
                            <i class="material-icons">arrow_drop_down</i> <!-- Иконка Font Awesome как разделитель -->
                        </div>
                        <div>
                            {{ form_row(form.artisan) }}
                            <span id="desc-anchor"></span>
                            {{ form_row(form.description) }}
                        </div>

                        <div class="text-center">
                            <button type="submit" id="register-button" class="btn btn-primary mt-3">
                                {% trans %}Update{% endtrans %}
                            </button>
                        </div>
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
