{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid mb-5 pb-5">
        <!-- Page Header -->
        <div class="page-header row no-gutters py-4" id="calendar">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <h3 class="page-title">
                    {% trans %}Diary{% endtrans %}
                </h3>
                <span class="text-uppercase page-subtitle">
                {% trans %}Describe your day in{% endtrans %} 300 {% trans %}characters{% endtrans %}
            </span>
            </div>
        </div>
        {% set path = app.request.pathinfo %}

        <!-- Если path = /cpanel/proposal/list то подключить /cpanel/journal/_calendar.html.twig -->
        {% if path == '/cpanel/proposal/list' %}
            {% include '/cpanel/journal/_calendar.html.twig' %}
        {% elseif path == '/cpanel/proposal/week' %}
            {% include '/cpanel/journal/_week.html.twig' %}
        {% endif %}

        <!-- Page Header -->
        <div class="page-header row no-gutters pb-3 pt-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <h3 class="page-title">{% trans %}Advisor{% endtrans %}</h3>
            </div>
        </div>
        <div class="card card-small">
            <div class="card-body p-0">
                {# Individual tasks #}
                <div class="d-flex align-items-center justify-content-between border p-3">
                    <div class="d-flex align-items-center">
                        <div class="blog-comments__avatar mr-3">
                            <img class="devstyle-user-avatar" src="{{ asset('/images/nf-ai.png') }}"
                                 alt="User avatar"/>
                        </div>
                        <div>
                            <div class="blog-comments__meta text-muted">
                                <a class="text-secondary" href="/cpanel/chat/neurify">
                                    NEURIFY MASTER
                                </a>
                            </div>
                            <p class="m-0 my-1 mb-2 text-muted">{% trans %}Tips for Challenges{% endtrans %}</p>
                        </div>
                    </div>
                    <span class="material-icons text-warning" style="font-size:20px;">
                            workspace_premium
                        </span>
                </div>
            </div>
        </div>

