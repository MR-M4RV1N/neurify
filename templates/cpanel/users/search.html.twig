{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Search Users{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- Page Header -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <span class="text-uppercase page-subtitle">{% trans %}Search results{% endtrans %}</span>
                <h3 class="page-title mb-2">
                    {% trans %}Query{% endtrans %}: "{{ query }}"
                </h3>
            </div>
        </div>
        <div class="row">
            {% for user in users %}
                <div class="col-lg-4 mb-4">
                    <div class="card card-small mb-4 pt-3 h-100">
                        <div class="card-body text-center">
                            <div class="mb-3 mx-auto">
                                <img class="rounded-circle devstyle-user-avatar" src="/cpanel/profile/uploads/images/{{ user.image }}" alt="User Avatar" width="110"> </div>
                            <h4 class="mb-0">{{ user.firstname }} {{ user.lastname }}</h4>
                            <span class="text-muted d-block mb-2">{% trans %}Level{% endtrans %} {{ user.progress|checkUserLevel(user.lang) }}</span>
                            <ul class="list-group list-group-flush">
                                <h6 class="text-center mt-3">{{ user.artisan }}</h6>
                                <li class="list-group-item px-4">
                                    <div class="progress-wrapper">
                                        <strong class="text-muted d-block mb-2">{% trans %}Progress{% endtrans %}</strong>
                                        <div class="progress progress-sm">
                                            {% set part = user.progress|default(0) %}
                                            {% set total = 100 %}
                                            {% set part = part > total ? total : part %}
                                            <div class="progress-bar bg-primary" role="progressbar" aria-valuenow="{{ part }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ (part / total * 100)|number_format(0) ~ '%' }};">
                                                <span class="progress-value">{{ (part / total * 100)|number_format(0) ~ '%' }}</span>
                                            </div>
                                        </div>
                                    </div>
                                </li>
                                <li class="list-group-item p-4 text-center">
                                    <form action="{{ path('app_users_user', {'id': user.id}) }}" method="get">
                                        <button type="submit" class="mb-2 btn btn-sm btn-pill btn-outline-primary mr-2">
                                            <i class="material-icons mr-1">input</i>{% trans %}Open{% endtrans %}
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            {% else %}
                <div>Nav neviena ieraksta.</div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
