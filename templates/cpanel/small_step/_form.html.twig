{# даём форме id, чтобы можно было удобно связывать кнопки #}
{{ form_start(form, { attr: { id: 'small-step-form', class: 'small-step-form', 'data-turbo': 'false'} }) }}

<div class="card-body border-bottom">
    <div class="form-group">
        <label class="small text-muted mb-1">{% trans %}Title{% endtrans %}</label>
        {{ form_widget(form.title, { attr: { class: 'form-control', placeholder: 'Например: дописать 1 абзац резюме', autocomplete: 'off' } }) }}
        {{ form_errors(form.title) }}
    </div>

    <details class="mt-2">
        <summary class="btn btn-light btn-sm d-flex justify-content-center" style="list-style: none;">
            <span>{% trans %}Other options{% endtrans %}</span>
            <span class="material-icons" style="font-size: 18px;">expand_more</span>
        </summary>

        <div class="mt-3">
            <div class="form-group">
                <label class="small text-muted mb-1">{% trans %}Category{% endtrans %}</label>
                {{ form_widget(form.category, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.category) }}
            </div>

            <div class="form-group">
                <label class="small text-muted mb-1">{% trans %}Date{% endtrans %}</label>
                {{ form_widget(form.date, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.date) }}
            </div>

            <div class="form-group">
                <label class="small text-muted mb-1">{% trans %}Description{% endtrans %}</label>
                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 4 } }) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="form-group">
                <label class="small text-muted mb-1">{% trans %}Type{% endtrans %}</label>
                {{ form_widget(form.draft, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.draft) }}
            </div>
        </div>
    </details>
</div>

{# ВАЖНО: закрываем form ДО футера с delete-формой #}
{{ form_rest(form) }}
{{ form_end(form) }}

<div class="card-footer">
    <div class="d-flex align-items-center">
        {# submit кнопка теперь ССЫЛАЕТСЯ на форму по id #}
        <button class="btn btn-primary" type="submit" form="small-step-form">
            {{ button_label|default('Save'|trans) }}
        </button>

        <a class="btn btn-outline-secondary mx-2" href="{{ path('app_proposal_week') }}">
            {% trans %}Cancel{% endtrans %}
        </a>

        <div class="w-100"></div>

        {% if form_type == 'edit' and step is defined %}
            {{ include('/cpanel/small_step/_delete_form.html.twig', { step: step }) }}
        {% endif %}
    </div>
</div>