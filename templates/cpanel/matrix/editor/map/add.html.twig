{% extends 'cpanel/_layouts/app.html.twig' %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- HEADER... -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <span class="text-uppercase page-subtitle">{% trans %}Structure your thinking{% endtrans %}</span>
                <h3 class="page-title">{% trans %}New table{% endtrans %}</h3>
            </div>
        </div>
        <!-- ...HEADER -->
        <!-- CONTENT... -->
        <div class="row border bg-white p-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="history.back()">
                <i class="fas fa-angle-left"></i> {% trans %}back{% endtrans %}
            </button>
        </div>
        <div class="row border bg-white mb-5">
            <div class="col-lg-12 col-md-12 col-sm-12 mt-4 mb-4">
                <form action="{{ path('map.create') }}" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <label class="form-label">{% trans %}Title{% endtrans %}:</label>
                        <input type="text" name="title" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>{% trans %}Category{% endtrans %}:</label>
                        <select class="custom-select" name="ensemble">
                            <option selected value="empty">{% trans %}Choose a category{% endtrans %}</option>
                            {% for ensemble in ensembles %}
                                <option value="{{ ensemble.id }}">{{ ensemble.title }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">{% trans %}Description{% endtrans %}:</label>
                        <textarea name="description" class="form-control" rows="3" data-ckeditor required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">{% trans %}Image{% endtrans %}:</label>
                        <input type="file" name="file" class="form-control" />
                    </div>

                    <div class="m-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="public" value="1" id="flexCheckChecked" checked>
                            <label class="form-check-label" for="flexCheckChecked">
                                {% trans %}To public{% endtrans %}
                            </label>
                        </div>
                    </div>
                    <div class="m-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="portfolio" value="1" id="flexCheckPortfolioChecked">
                            <label class="form-check-label" for="flexCheckPortfolioChecked">
                                {% trans %}Display in portfolio{% endtrans %}
                            </label>
                        </div>
                    </div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-sm btn-outline-primary mt-5">
                            <i class="material-icons">save</i> {{ button_label|default('Save'|trans) }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <!-- ...CONTENT -->
    </div>
{% endblock %}