{% extends 'cpanel/_layouts/app.html.twig' %}

{% block body %}
    <div class="main-content-container container-fluid">
        <!-- HEADER... -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 col-sm-4 text-center text-sm-left mb-0">
                <span class="text-uppercase page-subtitle">{% trans %}Structure your thinking{% endtrans %}</span>
                <h3 class="page-title">{% trans %}Table{% endtrans %}</h3>
            </div>
        </div>
        <!-- ...HEADER -->

        <!-- CONTENT... -->
        <div class="row border bg-white p-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="history.back()">
                <i class="fas fa-angle-left"></i> {% trans %}back{% endtrans %}
            </button>
        </div>

        <div class="d-flex justify-content-center border bg-white devstyle-content-area">
            <div class="col-lg-12 col-md-12 col-sm-12 mt-4 mb-4">
                <div>
                    <form action="{{ path('item.update', {'id': item.id}) }}" method="post"
                          enctype="multipart/form-data">
                        <div class="form-group">
                            <label>{% trans %}Title{% endtrans %}:</label>
                            <input type="text" class="form-control" name="title" value="{{ item.title }}">
                        </div>
                        <div class="form-group">
                            <!-- Отображаем если есть -->
                            {% if item.getFilename is defined and item.getFilename is not empty %}
                                <img style="width:100px;" id="blah"
                                     src="/cpanel/images/items/{{ item.getFilename }}"/>
                            {% else %}
                                <label class="form-label">{% trans %}Image{% endtrans %}:</label>
                            {% endif %}


                            <div class="d-flex flex-row-reverse">
                                <a href="{{ path('item.image.delete', {'id': item.id}) }}"
                                   class="btn btn-sm btn-danger ml-2"><i class="large material-icons">delete</i></a>
                                <!-- Форма загрузки файла -->
                                <input type="file" name="file" id="item-image-file" class="form-control"/>
                                <!-- И скрипт обновления отображённой картинки на странице (после загрузки файла) -->
                            </div>
                        </div>
                        <div class="form-group">
                            <label>{% trans %}Description{% endtrans %}:</label>
                            <textarea class="form-control" id="description" name="description" rows="3" data-ckeditor>{{ item.description }}</textarea>
                        </div>
                        <div class="text-center">
                            <button type="submit" class="btn btn-sm btn-primary">{% trans %}Save{% endtrans %}</button>
                        </div>
                        <div class="d-flex flex-row justify-content-end">
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-danger devstyle-delete-item-btn"
                                        data-id="{{ item.id }}">
                                    {% trans %}Delete{% endtrans %}
                                </button>
                            </div>
                        </div>
                        <!-- Модалка -->
                        <div class="modal" id="itemDeletingModal" tabindex="-1" role="dialog">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">{% trans %}Delete element{% endtrans %}</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        {% trans %}Are you sure?{% endtrans %}
                                    </div>
                                    <div class="modal-footer">
                                        <a href="{{ path('item.delete', {'id': item.id}) }}"
                                           class="btn btn-danger float-end m-1">{% trans %}Delete{% endtrans %}</a>
                                        <button class="btn btn-secondary" data-dismiss="modal">{% trans %}Close{% endtrans %}</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div >
        <!-- ...CONTENT -->
    </div>
{% endblock %}