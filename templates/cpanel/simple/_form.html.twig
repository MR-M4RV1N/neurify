{{ form_start(form, {'attr': {'data-form-type': 'simple'}}) }}

<style>
    .dropzone {
        border: 2px dashed #007bff;
        border-radius: 5px;
        padding: 20px;
        background: #f8f9fa;
        cursor: pointer;
    }
    .dropzone .dz-preview .dz-remove {
        color: #dc3545;
        text-decoration: none;
    }
</style>

<div class="mb-3">
    {{ form_label(form.title, null, {'label_attr': {'class': 'form-label'}}) }}
    {{ form_widget(form.title, {'attr': {'class': 'form-control',}}) }}
    {{ form_help(form.title) }}
    {{ form_errors(form.title) }}
</div>

<div class="mb-4">
    {{ form_label(form.content, null, {'label_attr': {'class': 'form-label mt-3'}}) }}
    {{ form_widget(form.content, {'attr': {
        'class': 'form-control',
        'data-ckeditor': 'true'
    }}) }}
    {{ form_help(form.content) }}
    {{ form_errors(form.content) }}
</div>

{% if existing_images is defined and existing_images|length > 0 %}
    <!-- Existing Images -->
    <div class="mb-4">
        <label>{{ 'Existing Images'|trans }}</label>
        <div class="row">
            {% for image in existing_images %}
                <div class="col-md-4 mb-3 position-relative">
                    <div class="devstyle-image-container position-relative" style="overflow: hidden; border-radius: 8px;">
                        <img src="/cpanel/images/simple/collections/{{ image.url }}" alt="Image" class="img-fluid rounded">
                        <button type="button" class="btn btn-sm btn-danger position-absolute devstyle-remove-image-btn"
                                data-id="{{ image.id }}" style="top: 10px; right: 10px;">
                            <i class="material-icons">delete</i>
                        </button>
                    </div>
                </div>
            {% else %}
                <p>{{ 'No images uploaded yet'|trans }}</p>
            {% endfor %}
        </div>
    </div>
{% endif %}

<!-- Dropzone for New Images -->
<div class="form-group">
    <label for="file-dropzone">{{ 'Upload New Images'|trans }}</label>
    <div id="file-dropzone" class="dropzone" data-upload-url="{{ path('app_simple_dropzone') }}"></div>
</div>
{% do form.images.setRendered() %}

<div>
    {{ form_label(form.ensemble, null, {'label_attr': {'class': 'form-label mt-2'}}) }}
    {{ form_widget(form.ensemble, {'attr': {'class': 'form-control'}}) }}
    {{ form_errors(form.ensemble) }}
</div>

<div>
    {{ form_widget(form.public, {'attr': {'class': 'form-select mr-2 ml-1 mt-4'}}) }}
    {{ form_label(form.public, null, {'label_attr': {'class': 'form-label'}}) }}
    {{ form_errors(form.public) }}
</div>

<div>
    {{ form_widget(form.portfolio, {'attr': {'class': 'form-select mr-2 ml-1 mt-4'}}) }}
    {{ form_label(form.portfolio, null, {'label_attr': {'class': 'form-label'}}) }}
    {{ form_errors(form.portfolio) }}
</div>

<div class="text-center">
    <button class="btn btn-sm btn-outline-primary mt-5">
        <i class="material-icons">save</i> {{ button_label|default('Save'|trans) }}
    </button>
</div>
{{ form_end(form) }}

<!-- Используется /init/simple-form.js -->
