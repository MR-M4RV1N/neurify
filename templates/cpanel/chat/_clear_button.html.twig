<div class="text-right">
    <form method="post"
          action="{{ path('neurify_chat_clear') }}"
          data-turbo-confirm="{% trans %}Clear chat history?{% endtrans %}">
        <input type="hidden" name="_token"
               value="{{ csrf_token('clear_chat') }}">

        <button type="submit"
                class="btn btn-link text-danger"
                title="{% trans %}Clear chat{% endtrans %}">
            <i class="material-icons align-middle">delete_forever</i>
            <span class="align-middle">
                {% trans %}Clear{% endtrans %}
            </span>
        </button>
    </form>
</div>