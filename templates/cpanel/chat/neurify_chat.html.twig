{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}Чат Neurify AI
{% endblock %}

{% block styles %}
	<style>
		.ai-loading-overlay {
			position: fixed;
			inset: 0;
			background: rgba(255, 255, 255, 0.85);
			z-index: 2000;
			display: flex;
			align-items: center;
			justify-content: center;
		}

		.ai-loading-box {
			display: flex;
			flex-direction: column;
			align-items: center;
		}

		/* Анимация "мыслящего AI" */
		.ai-loader {
			width: 64px;
			height: 64px;
			border-radius: 50%;
			background: radial-gradient(circle at center, #f0ad4e 40%, transparent 41%);
			animation: pulse-ai 1.4s infinite ease-in-out;
		}

		@keyframes pulse-ai {
			0% {
				transform: scale(0.9);
				opacity: 0.6;
			}
			50% {
				transform: scale(1.1);
				opacity: 1;
			}
			100% {
				transform: scale(0.9);
				opacity: 0.6;
			}
		}
	</style>
{% endblock %}

{% block body %}
	{% include '/cpanel/chat/_avatar.html.twig' %}

	<!---<div class="pt-2">
			        {% include '/cpanel/chat/_tabs.html.twig' %}
			    </div>-->

	<div class="main-content-container container-fluid mb-5">
		<div class="mt-4">
			<a href="/cpanel/all" class="text-muted text-decoration-none">
				<i class="fas fa-arrow-left mr-1"></i>
				{% trans %}Back{% endtrans %}
			</a>
		</div>
		<div class="card card-small p-1 mt-2 mb-5">
			<div>
				<h6 class="m-0 mt-3 text-center">
					Saruna ar Neurify Master (AI)
				</h6>
				<turbo-frame id="chat-mode-frame">
					<div class="form-group mb-2 text-center">
						<div
							class="dropdown d-inline-block">
							<!--<a class="dropdown-toggle text-decoration-none" href="#" id="chatModeDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
																						<small id="current-mode-label">
																							{% if app.session.get('ai_mode') == 'pro' %}
																								Pro
																							{% else %}
																								Lite
																							{% endif %}
																						</small>
																					</a>-->

							<div class="dropdown-menu" aria-labelledby="chatModeDropdown" style="min-width: 200px;">
								<a class="dropdown-item {% if app.session.get('ai_mode') == 'lite' %}active{% endif %}" href="{{ path('neurify_chat_set_mode', {mode: 'lite'}) }}" data-turbo="false">
									Lite
								</a>

								<a class="dropdown-item {% if app.session.get('ai_mode') == 'pro' %}active{% endif %}" href="{{ path('neurify_chat_set_mode', {mode: 'pro'}) }}" data-turbo="false">
									Pro
								</a>
							</div>
						</div>
					</div>
				</turbo-frame>

				<turbo-frame id="chat-clear-frame">
					{% if history is not empty %}
						{% include 'cpanel/chat/_clear_button.html.twig' %}
					{% endif %}
				</turbo-frame>
			</div>

			<div
				class="card-body p-0">
				{# AI INTRO — показываем ТОЛЬКО если чат ещё не начат #}
				{% if history is empty %}
					<div class="px-3 pt-3 text-center">
						<div id="output" data-text="{% trans %}Where would you like to start?{% endtrans %}"></div>
					</div>
				{% endif %}


				{# ===== ЧАТ-СООБЩЕНИЯ ===== #}
				<turbo-frame id="chat-messages">
					<div id="chat-messages-inner" class="pt-3">
						{% if history is not empty %}
							{% for msg in history %}
								{% if msg.role == 'user' %}
									{% include 'cpanel/chat/_message_user.html.twig' with { text: msg.content } %}
								{% else %}
									{% include 'cpanel/chat/_message_ai.html.twig' with { text: msg.content } %}
								{% endif %}
							{% endfor %}
						{% endif %}
					</div>
				</turbo-frame>

				{# ===== ФОРМА ===== #}
				<form method="post" action="{{ path('neurify_chat_send') }}" id="chat-form" class="px-3 py-2">

					<div class="form-group">
						<textarea name="message" rows="3" class="form-control" placeholder="{% trans %}Enter a message...{% endtrans %}"></textarea>
					</div>

					<div class="d-flex justify-content-end align-items-center mt-2">
						<button class="btn btn-warning btn-block text-white">
							<i class="fas fa-paper-plane mr-1"></i>
							{% trans %}Send{% endtrans %}
						</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<div id="ai-loading-overlay" class="ai-loading-overlay d-none">
		<div class="ai-loading-box text-center">
			<div class="ai-loader"></div>
			<div class="mt-3 text-muted">
				{% trans %}Neurify Master is thinking…{% endtrans %}
			</div>
		</div>
	</div>
{% endblock %}
