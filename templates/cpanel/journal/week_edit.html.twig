{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}
    {% trans %}Week reflection{% endtrans %}
    {{ weekStart|date('d.m') }} – {{ weekEnd|date('d.m') }}
{% endblock %}

{% block body %}
    <div class="main-content-container container-fluid">

        <!-- Page Header -->
        <div class="page-header row no-gutters py-4">
            <div class="col-12 text-center text-sm-left mb-0">
            <span class="text-uppercase page-subtitle">
                {% trans %}Weekly reflection{% endtrans %}
            </span>
                <h3 class="page-title">
                    {{ weekStart|date('d.m') }} – {{ weekEnd|date('d.m.Y') }}
                </h3>
            </div>
        </div>

        <!-- Breadcrumbs -->
        <div class="row bg-white shadow">
            <div class="col border-bottom">
                <div class="py-3 px-3">
                    <nav aria-label="breadcrumb">
                        <ol class="journal-pill-breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="{{ path('app_proposal_week') }}">
                                    {% trans %}Week{% endtrans %}
                                </a>
                            </li>

                            <li class="breadcrumb-separator">›</li>

                            <li class="breadcrumb-item">
                                <a href="{{ path('journal_week_show', { week: weekStart|date('Y-m-d') }) }}">
                                    {{ weekStart|date('d.m') }} – {{ weekEnd|date('d.m') }}
                                </a>
                            </li>

                            <li class="breadcrumb-separator">›</li>

                            <li class="breadcrumb-item active" aria-current="page">
                                {% trans %}Edit{% endtrans %}
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <!-- Edit form -->
        <div class="row bg-white shadow">
            <div class="col">
                <form method="post" class="p-3">
                    <div class="form-group">
                        <label class="small text-muted mb-2">{% trans %}Title{% endtrans %}</label>
                        <input name="title" class="form-control" type="text" placeholder="{% trans %}Enter your title{% endtrans %}" value="{{ comment.title ?? '' }}">
                    </div>

                    <div class="form-group">
                        <label class="small text-muted mb-2">
                            {% trans %}Summarize this week in your own words{% endtrans %}
                        </label>

                        <textarea
                                name="content"
                                class="form-control"
                                rows="10"
                                placeholder="{% trans %}What was important this week? What did you learn? What do you want to keep or change?{% endtrans %}"
                        >{{ comment.content ?? '' }}</textarea>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <small class="text-muted">
                            {% trans %}You can come back and edit this later.{% endtrans %}
                        </small>

                        <button type="submit" class="btn-accent-pill">
                            {% trans %}Save{% endtrans %}
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Spacer -->
        <div class="py-5"></div>

    </div>
{% endblock %}