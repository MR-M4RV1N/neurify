{% extends 'cpanel/_layouts/app.html.twig' %}

{% block title %}
	{% trans %}Week reflection{% endtrans %}
	{{ weekStart|date('d.m') }}
	–
	{{ weekEnd|date('d.m') }}
{% endblock %}

{% block styles %}{% endblock %}

{% block body %}
	<!-- Page Header -->
	<div class="page-header row no-gutters py-4">
		<div class="col-12 text-center text-sm-left mb-0">
			<div class="d-flex align-items-center justify-content-center justify-content-sm-start mb-1">
				<a href="{{ path('journal_week_show', { week: prevWeek|date('Y-m-d') }) }}" class="btn btn-white btn-sm btn-pill mr-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" title="{% trans %}Previous week{% endtrans %}">
					<i class="material-icons" style="font-size: 18px;">chevron_left</i>
				</a>
				<span class="text-uppercase page-subtitle mb-0">
					{{ weekStart|date('d.m') }}
					–
					{{ weekEnd|date('d.m.Y') }}
				</span>
				<a href="{{ path('journal_week_show', { week: nextWeek|date('Y-m-d') }) }}" class="btn btn-white btn-sm btn-pill ml-2 shadow-sm d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; padding: 0;" title="{% trans %}Next week{% endtrans %}">
					<i class="material-icons" style="font-size: 18px;">chevron_right</i>
				</a>
			</div>
			<h3 class="page-title">
				{% trans %}Week description{% endtrans %}
			</h3>
		</div>
	</div>

	<div class="main-content-container container-fluid">
		<div class="row">
			<div class="col-lg-8 col-md-12">
				<div class="card card-small mb-4">
					<div class="card-header border-bottom">
						<h6 class="m-0">{% trans %}Statistics{% endtrans %}</h6>
					</div>
					<div class="card-body text-center">
						<div class="mb-3">
							<div class="text-muted small">{% trans %}Characters written this week{% endtrans %}</div>
							<div class="h4 font-weight-bold mb-0 text-warning">{{ totalCharacters }}</div>
						</div>
						<hr>
						<a href="{{ path('journal_week_export', { week: weekStart|date('Y-m-d') }) }}" class="btn btn-sm btn-outline-secondary btn-pill">
							<i class="material-icons">file_download</i>
							{% trans %}Download{% endtrans %}
						</a>
					</div>
				</div>
			</div>
		</div>

		{# ========================= AI АНАЛИЗ НЕДЕЛИ ========================= #}
		<div class="card card-small mb-4">
			<div class="card-header border-bottom">
				<h6 class="m-0">{% trans %}Balance{% endtrans %}</h6>
			</div>
			<div class="card-body">
				{% if comment and comment.aiGenerated and comment.aiAnalysis %}
					{% include '/cpanel/journal/_wheel.html.twig' with {
                        lifeBalance: comment.aiAnalysis.life_balance
                    } %}

					<hr>
					{% if comment.score and comment.percent %}
						<div class="mx-4 my-2 text-center">
							<div class="font-weight-bold">
								{% trans %}Score{% endtrans %}
							</div>
							<div>
								{{ comment.score }}/60 ({{ comment.percent }}%)
							</div>
						</div>
					{% endif %}
					<hr>

					{% if comment.aiAnalysis.summary %}
						<h6 class="text-center">{% trans %}Summary{% endtrans %}</h6>

						<p class="mb-2">
							{{ comment.aiAnalysis.summary }}
						</p>
					{% endif %}

					{% if comment.aiAnalysis.recommendations is defined %}
						<h6 class="text-center">{% trans %}Recommendations{% endtrans %}</h6>
						<ul class="mb-0">
							{% for rec in comment.aiAnalysis.recommendations %}
								<li>{{ rec }}</li>
							{% endfor %}
						</ul>
					{% endif %}

				{% else %}
					<div class="text-center">
						<form method="post" id="ai-analysis-form" action="{{ path('journal_week_generate_ai', { week: weekStart|date('Y-m-d') }) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('journal_week_generate_ai') }}">

							<div class="mb-2">{% trans %}Сheck the week{% endtrans %}</div><br>
							<button type="submit" class="btn-accent-pill">
								{% trans %}Analyze{% endtrans %}
							</button>
						</form>
					</div>
				{% endif %}
			</div>
		</div>

		<div class="row">
			<div class="col-lg-8 col-md-12">
				<div class="card card-small mb-4">
					<div class="card-header border-bottom">
						<h6 class="m-0">{% trans %}My description{% endtrans %}</h6>
						<hr class="my-2">
						<div
							class="d-flex justify-content-between align-items-center">
							<!-- Breadcrumbs -->
							<nav aria-label="breadcrumb">
								<ol class="journal-pill-breadcrumb mb-0">
									<li class="breadcrumb-item">
										<a href="{{ path('app_proposal_week') }}">
											{% trans %}Week{% endtrans %}
										</a>
									</li>
									<li class="breadcrumb-separator">›</li>
									<li class="breadcrumb-item active" aria-current="page">
										{{ weekStart|date('d.m') }}
										–
										{{ weekEnd|date('d.m') }}
									</li>
								</ol>
							</nav>
							<div>
								<a href="{{ path('journal_week_edit', { week: weekStart|date('Y-m-d') }) }}" class="btn btn-sm btn-light text-warning">
									<span class="material-icons small">edit</span>
									{% trans %}Edit{% endtrans %}
								</a>
							</div>
						</div>
					</div>
					<div
						class="card-body">
						<!-- Content -->
						{% if comment and comment.content %}
							<div class="mb-2">
								<span class="font-weight-bold text-uppercase">{% trans %}Title{% endtrans %}:</span><br>
								{{ comment.title }}
							</div>
							<div class="weekly-comment-content">
								<span class="font-weight-bold text-uppercase">{% trans %}Description{% endtrans %}:</span><br>
								{{ comment.content|nl2br }}
							</div>
						{% else %}
							<div class="text-muted">
								<em>{% trans %}You haven’t commented on this week yet.{% endtrans %}</em>
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</div>

		<div class="card card-small mb-4">
			<div class="card-header border-bottom">
				<h6 class="m-0">{% trans %}Events{% endtrans %}</h6>
			</div>
			<div class="card-body">
				{% if events is not empty %}
					<ul class="list-group list-group-flush">
						{% for item in events %}
							<li class="list-group-item" style="padding: 7px 0px 7px 0px;">
								<div class="d-flex">
									<div>
										<img class="devstyle-circle-image mr-3" src="/cpanel/images/events/collections/{{ item.mainImage ?? 'default-min.jpg' }}">
									</div>
									<div>
										<a href="{{ path('app_event_show', {'id': item.id}) }}">
											{{ item.title }}
										</a>
										<div class="small text-muted">{{ item.date|date('d M Y') }}</div>
									</div>
								</div>
							</li>
						{% endfor %}
					</ul>
				{% else %}
					<em class="text-muted">
						{% trans %}No events this week.{% endtrans %}
					</em>
				{% endif %}
			</div>
		</div>
		<!-- Spacer -->
		<div class="my-5 py-5"></div>
	</div>

	<div id="ai-loading-overlay" class="ai-loading-overlay d-none">
		<div class="ai-loading-box text-center">
			<div class="ai-loader"></div>
			<div class="mt-3 text-muted">
				{% trans %}Neurify Master is thinking…{% endtrans %}
			</div>
		</div>
	</div>
{% endblock %}
