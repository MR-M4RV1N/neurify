{% extends 'security/base.html.twig' %}

{% block title %}Register
{% endblock %}

{% form_theme registrationForm 'bootstrap_4_layout.html.twig' %}

{% block body %}
	<div class="w-100" style="max-width: 500px;">
		<div class="card border-0 shadow-lg rounded-4 overflow-hidden mb-5 mt-5">
			<div class="bg-primary text-white text-center py-4">
				<img src="/cpanel/images/admin-panel-primary.png" style="width:50px; filter: brightness(0) invert(1);" class="mb-2">
				<h4 class="mb-0 fw-bold">{% trans %}Register{% endtrans %}</h4>
			</div>

			<div class="card-body p-4 p-md-5">
				{% for error in registrationForm.email.vars.errors %}
					<div class="alert alert-danger rounded-3">{{ error.message }}</div>
				{% endfor %}

				{{ form_start(registrationForm) }}

				<div class="form-floating mb-3">
					{{ form_widget(registrationForm.email, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'name@example.com'}}) }}
					{{ form_label(registrationForm.email, null, {'label_attr': {'class': 'text-muted'}}) }}
					{{ form_errors(registrationForm.email) }}
				</div>

				<div class="form-floating mb-4">
					{{ form_widget(registrationForm.username, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'Username'}}) }}
					{{ form_label(registrationForm.username, null, {'label_attr': {'class': 'text-muted'}}) }}
					{{ form_errors(registrationForm.username) }}
				</div>

				<h6 class="text-muted mb-3 small text-uppercase fw-bold">{% trans %}Password{% endtrans %}</h6>

				<div class="form-floating mb-3">
					{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'Password'}}) }}
					{{ form_label(registrationForm.plainPassword.first, null, {'label_attr': {'class': 'text-muted'}}) }}
					{{ form_errors(registrationForm.plainPassword.first) }}
				</div>

				<div class="form-floating mb-4">
					{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'Repeat Password'}}) }}
					{{ form_label(registrationForm.plainPassword.second, null, {'label_attr': {'class': 'text-muted'}}) }}
					{{ form_errors(registrationForm.plainPassword.second) }}
				</div>

				<h6 class="text-muted mb-3 small text-uppercase fw-bold">{% trans %}Name{% endtrans %}</h6>

				<div class="row g-2 mb-4">
					<div class="col-md-6">
						<div class="form-floating">
							{{ form_widget(registrationForm.firstname, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'First Name'}}) }}
							{{ form_label(registrationForm.firstname, null, {'label_attr': {'class': 'text-muted'}}) }}
							{{ form_errors(registrationForm.firstname) }}
						</div>
					</div>
					<div class="col-md-6">
						<div class="form-floating">
							{{ form_widget(registrationForm.lastname, {'attr': {'class': 'form-control rounded-3', 'placeholder': 'Last Name'}}) }}
							{{ form_label(registrationForm.lastname, null, {'label_attr': {'class': 'text-muted'}}) }}
							{{ form_errors(registrationForm.lastname) }}
						</div>
					</div>
				</div>

				<h6 class="text-muted mb-3 small text-uppercase fw-bold">{% trans %}Other{% endtrans %}</h6>

				<div class="form-floating mb-3">
					{{ form_widget(registrationForm.country, {'attr': {'class': 'form-select rounded-3'}}) }}
					{{ form_label(registrationForm.country, null, {'label_attr': {'class': 'text-muted'}}) }}
					{{ form_errors(registrationForm.country) }}
				</div>

				<div class="form-floating mb-4">
					{{ form_widget(registrationForm.lang, {'attr': {'class': 'form-select rounded-3'}}) }}
					{{ form_label(registrationForm.lang, null, {'label_attr': {'class': 'text-muted'}}) }}
					{{ form_errors(registrationForm.lang) }}
				</div>

				<div class="form-check mb-4 p-3 bg-light rounded-3 border">
					<div class="mb-2">
						<a href="#" data-bs-toggle="modal" data-bs-target="#termsModal" class="text-decoration-none fw-bold small">{% trans %}Read the terms{% endtrans %}</a>
					</div>
					<div>
						{{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input mt-1'}}) }}
						{{ form_label(registrationForm.agreeTerms, 'I accept the <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal" class="text-decoration-none">Terms and Conditions</a>', {'label_attr': {'class': 'form-check-label text-muted small'}}) | raw }}
						{{ form_errors(registrationForm.agreeTerms) }}
					</div>
				</div>

				{# Honeypot field (hidden usually) #}
				<div class="d-none">
					{{ form_widget(registrationForm.city) }}
				</div>

				<div class="d-grid gap-2 mb-4">
					<button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold">{% trans %}Register{% endtrans %}</button>
				</div>

				<div class="position-relative mt-4 mb-4">
					<hr class="text-muted">
					<div class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small">{% trans %}or{% endtrans %}</div>
				</div>

				<div class="d-grid gap-2">
					<a href="{{ path('connect_google_start') }}" class="btn btn-outline-danger btn-lg rounded-pill fw-bold d-flex align-items-center justify-content-center">
						<i class="fab fa-google fs-5 me-2"></i>
						{% trans %}Register with Google{% endtrans %}
					</a>
				</div>

				<div class="text-center mt-4">
					<p class="text-muted small mb-0">
						{% trans %}Already have an account{% endtrans %}?
						<a href="{{ path('app_login') }}" class="text-decoration-none fw-bold">{% trans %}Log In{% endtrans %}</a>
					</p>
				</div>

				{{ form_end(registrationForm) }}

				{# Модальное окно с соглашением #}
				{% include 'registration/_agreement.html.twig' %}
			</div>
		</div>
	</div>
{% endblock %}
